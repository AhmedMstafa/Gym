@using Gym.Business.ViewModels.Members
@using Gym.DataAccess.Enums
@model CreateMemberViewModel
@{
    ViewData["Title"] = "Create Member";
}

<div class="container">
    <partial name="_TempDataAlert" />
    <main role="main" class="pb-3">

        <header class="mb-4">
            <h3 class="text-primary-color">Add Member</h3>
        </header>

        <form method="post" asp-controller="Members" asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Step navigation -->
            <ul class="nav nav-tabs mb-4" id="addMemberTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="member-tab" data-bs-toggle="tab" data-bs-target="#member-info" type="button" role="tab">Member Info</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="health-tab" data-bs-toggle="tab" data-bs-target="#health-info" type="button" role="tab">Health Data</button>
                </li>
            </ul>

            <!-- Tab content -->
            <div class="tab-content">
                <!-- Member Info -->
                <div class="tab-pane fade show active" id="member-info" role="tabpanel" aria-labelledby="member-tab">
                    <div class="section-header mb-3">
                        <h5 class="text-primary fw-bold">Personal Information</h5>
                        <hr class="mt-2">
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Photo" class="form-label">Profile Photo <span class="text-danger">*</span></label>
                            <input asp-for="Photo" type="file" class="form-control" accept="image/*" id="photoInput" required />
                            <span asp-validation-for="Photo" class="text-danger"></span>
                            <small class="form-text text-muted">Max size: 5 MB. Allowed types: JPG, PNG, WebP (Required)</small>
                            <div class="mt-2">
                                <img id="photoPreview" src="#" alt="Photo Preview" style="max-width: 200px; display: none;" class="img-thumbnail" />
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" type="text" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">
                                <option value="">-- Select Gender --</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="section-header mb-3 mt-4">
                        <h5 class="text-primary fw-bold">Address Information</h5>
                        <hr class="mt-2">
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="BuildingNumber" class="form-label"></label>
                            <input asp-for="BuildingNumber" class="form-control" />
                            <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" />
                            <span asp-validation-for="Street" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Health Data -->
                <div class="tab-pane fade" id="health-info" role="tabpanel" aria-labelledby="health-tab">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="HealthRecord.Hight" class="form-label"></label>
                            <input type="number" asp-for="HealthRecord.Hight" class="form-control" />
                            <span asp-validation-for="HealthRecord.Hight" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="HealthRecord.Weight" class="form-label"></label>
                            <input type="number" asp-for="HealthRecord.Weight" class="form-control" />
                            <span asp-validation-for="HealthRecord.Weight" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="HealthRecord.BloodType" class="form-label"></label>
                            <select asp-for="HealthRecord.BloodType" asp-items="Html.GetEnumSelectList<BloodType>()" class="form-select">
                                <option value="">-- Select Blood Type --</option>
                            </select>
                            <span asp-validation-for="HealthRecord.BloodType" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="HealthRecord.Notes" class="form-label"></label>
                            <input asp-for="HealthRecord.Notes" class="form-control" />
                            <span asp-validation-for="HealthRecord.Notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="d-flex justify-content-end gap-3 mt-4">
                <a asp-controller="Members" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-2"></i> Back to List
                </a>

                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-plus-circle me-2"></i> Add
                </button>
            </footer>
        </form>

    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Preview photo before upload
        (function () {
            var input = document.getElementById('photoInput');
            var preview = document.getElementById('photoPreview');

            if (!input || !preview) {
                return;
            }

            input.addEventListener('change', function (e) {
                var file = e.target.files && e.target.files[0];

                if (!file) {
                    preview.style.display = 'none';
                    preview.removeAttribute('src');
                    return;
                }

                var maxBytes = 5 * 1024 * 1024;
                if (file.size > maxBytes) {
                    alert('Image size must be 5 MB or less.');
                    input.value = '';
                    preview.style.display = 'none';
                    preview.removeAttribute('src');
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (event) {
                    preview.src = event.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            });
        })();
    </script>
}
