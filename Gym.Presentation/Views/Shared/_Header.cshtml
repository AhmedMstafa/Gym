@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string IsActive(string targetController, string targetAction = "")
    {
        bool controllerMatch = string.Equals(controller, targetController, StringComparison.OrdinalIgnoreCase);
        if (!string.IsNullOrEmpty(targetAction))
        {
            bool actionMatch = string.Equals(action, targetAction, StringComparison.OrdinalIgnoreCase);
            return (controllerMatch && actionMatch) ? "active" : "";
        }
        return controllerMatch ? "active" : "";
    }
}

<header>
    <nav class="navbar navbar-expand-lg bg-white my-3">
        <div class="container">
            <a class="navbar-brand" href="#">
                <img src="~/images/logo.jpg" alt="" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @IsActive("Home", "Index")"
                           aria-current="@(IsActive("Home", "Index") == "active" ? "page" : null)"
                           asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @IsActive("Members")"
                           aria-current="@(IsActive("Members") == "active" ? "page" : null)"
                           asp-controller="Members" asp-action="Index">Members</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @IsActive("Trainer")"
                           aria-current="@(IsActive("Trainers") == "active" ? "page" : null)"
                           asp-controller="Trainer" asp-action="Index">Trainers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @IsActive("Sessions", "Index")"
                           aria-current="@(IsActive("Sessions", "Index") == "active" ? "page" : null)"
                           asp-controller="Sessions" asp-action="Index">Sessions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @IsActive("Plans")"
                           aria-current="@(IsActive("Plans") == "active" ? "page" : null)"
                           asp-controller="Plans" asp-action="Index">Plans</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @IsActive("Membership")"
                           aria-current="@(IsActive("Membership") == "active" ? "page" : null)"
                           asp-controller="Membership" asp-action="Index">Memberships</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @IsActive("Sessions", "Booking")"
                           aria-current="@(IsActive("Sessions", "Schedule") == "active" ? "page" : null)"
                           asp-controller="Booking" asp-action="Index">Sessions Schedule</a>
                    </li>
                    <li class="nav-item">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit"
                                        class="btn btn-link nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @IsActive("Account", "Login")"
                               asp-controller="Account" asp-action="Login">Login</a>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>