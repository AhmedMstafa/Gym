<script>
    (function () {
        const categorySelect = document.getElementById('CategoryId');
        const trainerSelect = document.getElementById('TrainerId');
        if (!categorySelect || !trainerSelect) return;

        const trainersUrl = '@Url.Action("TrainersForCategory", "Sessions")';
        const placeholder = '-- Select Trainer --';

        async function loadTrainers(categoryId, selectedTrainerId) {
            trainerSelect.innerHTML = '';
            const defaultOption = document.createElement('option');
            defaultOption.value = '';
            defaultOption.textContent = placeholder;
            trainerSelect.appendChild(defaultOption);

            if (!categoryId) {
                trainerSelect.disabled = true;
                return;
            }

            trainerSelect.disabled = true;
            try {
                const response = await fetch(`${trainersUrl}?categoryId=${encodeURIComponent(categoryId)}`);
                if (!response.ok) return;

                const trainers = await response.json();
                for (const trainer of trainers) {
                    const option = document.createElement('option');
                    option.value = trainer.id;
                    option.textContent = trainer.name;
                    if (selectedTrainerId && String(trainer.id) === String(selectedTrainerId)) {
                        option.selected = true;
                    }
                    trainerSelect.appendChild(option);
                }
            } finally {
                trainerSelect.disabled = false;
            }
        }

        categorySelect.addEventListener('change', function () {
            loadTrainers(categorySelect.value, null);
        });

        const initialCategoryId = categorySelect.value;
        const initialTrainerId = trainerSelect.value;
        if (initialCategoryId) {
            loadTrainers(initialCategoryId, initialTrainerId);
        } else {
            trainerSelect.disabled = true;
        }
    })();
</script>
